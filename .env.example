# ============================================================
#  AutoREADME — Environment Configuration Template
#  Copy this file to .env and populate your credentials
# ============================================================

# AI Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GitHub Credentials (For autonomous git commits & API triggers)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=your_github_username_here
GITHUB_REPO=your_username/your_repository_name

# Git Identity (Used for commit authorship)
GIT_USER_NAME=AutoREADME Bot
GIT_USER_EMAIL=bot@autoreadme.dev

# Supabase Telemetry & System Config Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# Dashboard Access Control
DASHBOARD_PASSWORD=your_secure_dashboard_password
